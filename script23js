//Estrutura de Decisão Encadeada
 
alert("Dia da semana")
 
let numero = parseInt(prompt("Digite um número"))
if (numero == 1) {
    alert("Domingo")
} else
    if (numero == 2) {
        alert("Segunda")
    } else
        if (numero == 3) {
            alert("Terça")
        } else
            if (numero == 4) {
                alert("Quarta")
            } else
                if (numero == 5) {
                    alert("Quinta")
                } else
                    if (numero == 6) {
                        alert("Sexta")
                    }
                    else
                        if (numero == 7) {
                            alert("Sabádo")
                        }
                        else{
                            alert("Não possui dia correspondente")
                        }
 